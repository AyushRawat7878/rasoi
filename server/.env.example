# Copy this file to .env and change the values.

# Leave MONGODB_URI empty to use a local database that starts automatically
# (saved in your user folder, e.g. C:\Users\you\AppData\Local\rasoi-db).
# To use a free cloud database, paste your MongoDB Atlas connection string here.
MONGODB_URI=

# Any long random text. It signs the login tokens.
JWT_SECRET=change-this-to-a-long-random-string

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# The admin account created on first run
ADMIN_EMAIL=admin@rasoi.test
ADMIN_PASSWORD=admin12345
